# .wiki_ignore — files/dirs excluded from staleness detection
# Add project-specific patterns below. Lines starting with # are comments.

# Wiki self-ignore — wiki edits don't trigger staleness
docs/wiki/

# Common build/dependency/cache directories
node_modules/
dist/
build/
.next/
.cache/
__pycache__/
.DS_Store
.svelte-kit/

# Orca session artifacts — agent scratch space (BrowserOS neo logs, code-review
# reports, handoffs). Ephemeral by nature; durable findings get mined into the
# wiki by the recap agent, the files themselves are not documentation.
.monster/

# Scratch duplicates of generated Risk boards (Windows explorer copies, superseded experiments)
docs/risk/risk-dart-board - Copy.svg
docs/risk/risk-dart-board - Copy (2).svg
